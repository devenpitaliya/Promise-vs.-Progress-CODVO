# =============================================================================
# Promise vs. Progress: the ONE configuration file for the whole project.
# Copy to `.env` in this folder. It is read by:
#   - the backend (FastAPI)       -> all non-VITE_ variables
#   - the frontend (Vite)         -> only VITE_* variables reach the browser bundle;
#                                    the dev server also reads APP_PORT / FRONTEND_PORT
#   - docker compose              -> everything, plus the "Docker" section
# Never put secrets in VITE_* variables: they are embedded in public JavaScript.
# =============================================================================

# ---- Application -------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
APP_NAME=Promise vs. Progress Engine
# bind address for `python -m app`
APP_HOST=0.0.0.0
# backend port (dev server proxies /api here)
APP_PORT=8000
# auto-reload for local development only
APP_RELOAD=true
API_PREFIX=/api/v1
# IANA zone that decides what "today" means
APP_TIMEZONE=UTC

# ---- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
# Folder for log files; relative paths are resolved from the project root
LOG_DIR=logs
# Files are named <prefix>_YYYY-MM-DD_HH-MM-SS.log (the time the file was started)
LOG_FILE_PREFIX=app
# A new file starts when the current one reaches this size (MB)
LOG_FILE_MAX_MB=2
# Keep at most this many files; the oldest are deleted automatically
LOG_MAX_FILES=6
# Also delete files older than this many days (0 = keep by count only)
LOG_RETENTION_DAYS=7

# ---- Startup checks ----------------------------------------------------------
# Probe every connection before serving traffic and log OK / WARN / FAIL for each
STARTUP_CHECKS_ENABLED=true
# Max seconds per check
STARTUP_CHECK_TIMEOUT_SECONDS=10
# Live probe of configured AI keys (one tiny request per provider)
STARTUP_CHECK_LLM=true
# Verify the GitHub token with a real API call
STARTUP_CHECK_GITHUB=true
# Log in to the SMTP server to verify credentials
STARTUP_CHECK_SMTP=true
# Verify the Langfuse keys (only when LANGFUSE_ENABLED=true)
STARTUP_CHECK_LANGFUSE=true
# Refuse to start on any warning (a database failure always stops startup)
STARTUP_FAIL_ON_WARNING=false

# ---- Frontend / HTTP ---------------------------------------------------------
# Vite dev server port
FRONTEND_PORT=5173
# public URL of the web app (always allowed by CORS)
FRONTEND_URL=http://localhost:5173
# extra allowed origins, comma-separated
CORS_ORIGINS=
# empty = same origin /api/v1 (dev proxy / nginx). Set only for a separate API domain.
VITE_API_URL=
# browser request timeout
VITE_API_TIMEOUT_MS=60000

# ---- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and makes stored per-user AI keys unreadable.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_MIN_LENGTH=10
LOGIN_ATTEMPTS_PER_MINUTE=10
SIGNUPS_PER_HOUR_PER_IP=5
# "Try a private demo workspace" on the sign-in page
DEMO_MODE=false

# ---- Storage -----------------------------------------------------------------
# relative to backend/ ; holds SQLite + vector index
DATA_DIR=./data
# empty = SQLite in DATA_DIR; e.g. postgresql+asyncpg://user:pass@db:5432/pvp
DATABASE_URL=
RUN_MIGRATIONS_ON_STARTUP=true
# Sample transcripts offered in the New meeting wizard (relative paths are from the project root)
SAMPLES_DIR=samples
# Postgres connection pool per API process (ignored for SQLite).
# Keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) x processes under Postgres max_connections, or use PgBouncer.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# ---- LLM: shared generation settings -----------------------------------------
# gemini | openai (tried first when both have keys)
LLM_DEFAULT_PROVIDER=gemini
# 0.0 - 2.0; low = consistent, factual output
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
# agent retries when the model returns invalid JSON (0-3)
LLM_MAX_REPAIR_ATTEMPTS=1
# Retries for temporary provider errors (HTTP 429 / 5xx), with exponential backoff
LLM_TRANSIENT_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=2
# After a "quota exceeded" error, skip that model for this many seconds and use the fallback directly
LLM_MODEL_COOLDOWN_SECONDS=300
# optional override for commitment extraction
EXTRACTION_TEMPERATURE=
# optional override for the briefing narrative
BRIEFING_TEMPERATURE=

# ---- LLM: providers (optional; users can also add their own keys in Settings) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Lighter model tried automatically when GEMINI_MODEL is overloaded (HTTP 429/5xx); empty = none
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=
# OpenAI-compatible endpoint (Azure, vLLM, gateway); empty = api.openai.com
OPENAI_BASE_URL=

# ---- Extraction & search -----------------------------------------------------
MAX_TRANSCRIPT_CHARS=100000
MAX_PARTICIPANTS=50
SEMANTIC_SEARCH_ENABLED=true
# local (offline) | gemini (needs GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
SEMANTIC_SEARCH_RESULTS=10

# ---- GitHub (empty token = clearly labelled simulation mode) -----------------
# fine-grained: Issues read/write, Pull requests read
GITHUB_PERSONAL_ACCESS_TOKEN=
# owner used when a repository is given without "owner/"
GITHUB_DEFAULT_OWNER=
# change for GitHub Enterprise Server
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=10
GITHUB_MAX_CONCURRENCY=8

# ---- Jira (optional server-wide default) -------------------------------------
# Users can connect their own Jira in Settings > Integrations; that always wins.
# Empty = Jira commitments run in clearly labelled simulation mode.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_TIMEOUT_SECONDS=10

# ---- Slack (optional server-wide default) ------------------------------------
# Either an incoming webhook URL, or a bot token (chat:write) plus a channel.
# Users can connect their own Slack in Settings > Integrations.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
SLACK_TIMEOUT_SECONDS=10

# ---- Integrations ------------------------------------------------------------
# Tools users can connect (comma-separated: github, jira, slack). Others show as "Coming soon".
ENABLED_INTEGRATIONS=github
# Connectors only call the tools' own domains (github.com, atlassian.net, hooks.slack.com).
# Add self-hosted hosts here, comma-separated, e.g. jira.mycompany.com
INTEGRATION_ALLOWED_HOSTS=
# "Test connection" clicks allowed per user and tool per 5 minutes
INTEGRATION_TESTS_PER_5_MIN=20

# ---- Reconciliation ----------------------------------------------------------
# due within N days with no progress => "at risk"
AT_RISK_WINDOW_DAYS=2
# background GitHub re-check interval
VERIFICATION_INTERVAL_MINUTES=60
# with several API replicas, enable in exactly one
ENABLE_SCHEDULER=true

# ---- Email (empty = briefings saved but not sent) ----------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=briefings@example.com
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
EMAILS_PER_USER_PER_DAY=50

# ---- Observability: Langfuse (LLM tracing, tokens, cost) ---------------------
# Master switch. false = no tracing at all. If Langfuse is down or misconfigured,
# the app keeps working and only logs a warning.
LANGFUSE_ENABLED=false
# Project keys from Langfuse > Settings > API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU) | https://us.cloud.langfuse.com (US) | self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Environment label on traces; empty = ENVIRONMENT (lowercase letters, digits, - or _)
LANGFUSE_ENVIRONMENT=
# Release/version label on traces, e.g. a git SHA; empty = none
LANGFUSE_RELEASE=
# Share of traces to keep, 0.0 - 1.0
LANGFUSE_SAMPLE_RATE=1.0
# Send prompts, transcripts and model outputs. false = only metadata, tokens, cost and timings
LANGFUSE_CAPTURE_CONTENT=true
# Send a batch after this many events, or after this many seconds
LANGFUSE_FLUSH_AT=15
LANGFUSE_FLUSH_INTERVAL_SECONDS=5
LANGFUSE_TIMEOUT_SECONDS=10
# Verbose SDK logging
LANGFUSE_DEBUG=false
# Optional USD prices per 1M tokens for models Langfuse cannot price itself:
# model=input/output, comma-separated, e.g. gemini-3.8-flash=0.30/2.50,gpt-4o-mini=0.15/0.60
LLM_PRICING=

# ---- Docker (docker compose only) --------------------------------------------
# host port for the web UI; the API is served behind it at /api
WEB_PORT=8080
